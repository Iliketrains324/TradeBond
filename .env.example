# TradeBond v4.1 settings. Copy this file to .env (same folder as server.js).
# .env holds every secret: the AI key and the wallet keys. Never share it, upload it, or put a key in any other file.
# On a host (Render, Railway, a VPS...), put these in the host's environment-variable settings instead of uploading .env.

# ---- AI (document reading, chat-to-order, negotiation, Bao's FAQ answers) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_RATE_PER_MINUTE=20          # per visitor
AI_MAX_CALLS_PER_DAY=500       # whole site

# ---- Blockchain (real transactions) ----
# Local:   start "anvil" in another terminal, then "npm run deploy:local" fills everything below.
# Testnet: set RPC_URL, CHAIN_NAME, EXPLORER_URL, run "npm run deploy" once (it creates DEPLOYER_KEY),
#          send faucet gas to the address it prints, then run "npm run deploy" again.
RPC_URL=
CHAIN_ID=
CHAIN_NAME=
CHAIN_SYMBOL=ETH
EXPLORER_URL=                  # e.g. https://sepolia.etherscan.io  (links on every transaction)
GAS_PER_ROLE=0.02              # test gas the deployer gives each role wallet

# Role wallets (filled by deploy.js; each role has its own key so the contract enforces who may do what)
DEPLOYER_KEY=                  # regulator / compliance officer
OWNER_KEY=                     # the business owner (funds trades, approves, changes rules)
PAYMENT_AGENT_KEY=             # the only wallet allowed to ask the escrow to pay
DOCUMENT_AGENT_KEY=            # records what it read; cannot pay
NEGOTIATION_AGENT_KEY=         # records agreements; moves no money
INSPECTOR_KEY=                 # independent: confirms what arrived
SELLER_KEY=                    # the seller's receiving wallet
SELLER_AGENT_KEY=              # signs the seller side of the negotiation
OPERATOR_KEY=                  # the bond operator (the agent's provider): posts and tops up the bond, never the owner

# Starting rules for the payment agent (the owner can change them later with "Change rules")
MAX_PER_PAYMENT=800000
MAX_PER_DAY=1600000            # a real owner's cap (use this for filming); raise it, e.g. 50000000, only for a shared public link
CONFIRM_ABOVE=100000
MAX_AUTO_PAYMENTS=5
START_BOND=50000

# Limits on the transaction endpoints
CHAIN_RATE_PER_MINUTE=90       # per visitor
CHAIN_MAX_TX_PER_DAY=3000      # whole site

PORT=3000
